# Canonical URL rules for Hostinger (Apache) static export.
# Canonical form: https://iptv-norwegian.com/.../  (HTTPS, non-www, trailing slash)

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS + non-WWW → https://iptv-norwegian.com
  RewriteCond %{HTTP_HOST} ^(www\.)?iptv-norwegian\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.iptv-norwegian\.com$ [NC]
  RewriteRule ^ https://iptv-norwegian.com%{REQUEST_URI} [L,R=301]

  # Retired routes stay off the index. Send visitors to the homepage.
  RewriteRule ^(subscription-plans|installation-guide|reseller-panel|blog|contact)(/.*)?$ / [L,R=301]

  # 2. Force trailing slash (skip real files and extensioned assets)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,8}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# Proper 404 status for unknown routes (Next.js static export outputs /404.html)
ErrorDocument 404 /404.html

# Discourage indexing of the error document when served directly
<IfModule mod_headers.c>
  <Files "404.html">
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>
